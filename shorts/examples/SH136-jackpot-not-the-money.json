  "scenes": [
    {
      "narration": "That giant jackpot on the billboard? It is not actually the money you'd ever receive. Not even close.",
      "shots": [
        {
          "block": "hook",
          "art": "vault",
          "props": [
            "coin",
            "x"
          ],
          "lines": [
            "The jackpot",
            "isn't the money."
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "The headline number is the annuity, paid out slowly over about thirty years.",
      "shots": [
        {
          "block": "truth",
          "art": "vault",
          "kicker": "the fine print",
          "line": "It's an annuity",
          "sub": "paid over ~30 years"
        }
      ],
      "id": "s2"
    },
    {
      "narration": "The advertised jackpot assumes decades of future payments.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-jackpot",
          "kicker": "Wikipedia · progressive jackpot"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "Take the cash instead, and the lump sum is often only about half of that headline.",
      "shots": [
        {
          "block": "stat",
          "art": "vault",
          "big": "~ half",
          "label": "the lump sum vs headline",
          "props": [
            "chartDown",
            "coin"
          ]
        }
      ],
      "id": "s4"
    },
    {
      "narration": "A lump sum pays less now instead of more, spread out later.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-lump",
          "kicker": "Wikipedia · lump sum"
        }
      ],
      "id": "s5"
    },
    {
      "narration": "Then income tax lands on top, taking another large chunk right away.",
