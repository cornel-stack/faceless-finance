  "scenes": [
    {
      "narration": "Waiting just ten years to start investing feels harmless. The actual price tag on that delay is shocking.",
      "shots": [
        {
          "block": "hook",
          "art": "bank",
          "props": [
            "coin",
            "clock"
          ],
          "lines": [
            "Waiting 10 years",
            "costs you..."
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "Picture the same monthly amount, same return, with one person simply starting a decade earlier.",
      "shots": [
        {
          "block": "thennow",
          "kicker": "Same money, 10 years apart",
          "thenLabel": "Start at 25",
          "nowLabel": "Start at 35",
          "thenValue": "much more",
          "nowValue": "far less",
          "sub": "one decade changes everything"
        }
      ],
      "id": "s2"
    },
    {
      "narration": "That gap is the time value of money, a dollar today beats a dollar later.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-timevalue",
          "kicker": "Wikipedia · time value of money"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "The one who started at twenty-five can end up with two to three times as much.",
      "shots": [
        {
          "block": "stat",
          "art": "bank",
          "big": "2–3×",
          "label": "more, just from starting early",
          "props": [
            "chartUp",
            "coin"
          ]
        }
      ],
      "id": "s4"
    },
    {
      "narration": "Because compounding rewards the extra years far more than extra dollars.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-compound",
          "kicker": "Wikipedia · compound interest"
        }
      ],
      "id": "s5"
    },
    {
      "narration": "To catch up after waiting, the late starter has to invest several times as much each month.",
      "shots": [
        {
          "block": "stat",
          "art": "bank",
          "big": "4×",
          "label": "the catch-up cost of waiting",
          "props": [
            "coin",
            "fire"
          ]
        }
      ],
      "id": "s6"
    },
    {
      "narration": "Every year you delay quietly hands away growth you can never get back.",
      "shots": [
        {
          "block": "flash",
          "bg": "red",
          "line": "Growth you can't reclaim",
          "props": [
            "chartDown",
            "clock"
          ]
        }
      ],
      "id": "s7"
    },
    {
      "narration": "That lost growth is a pure opportunity cost.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-opportunity",
          "kicker": "Wikipedia · opportunity cost"
        }
      ],
      "id": "s8"
    },
    {
      "narration": "Procrastination is quietly the single most expensive habit in all of personal finance.",
      "shots": [
        {
          "block": "flash",
          "bg": "red",
          "line": "Delay = expensive",
          "props": [
            "clock",
            "fire"
          ]
        }
      ],
      "id": "s9"
    },
    {
      "narration": "Assuming steady long-run S&P 500 returns the whole way.",
