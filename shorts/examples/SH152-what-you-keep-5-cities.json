  "scenes": [
    {
      "narration": "Take the same solid salary into five big cities, and watch how differently it ends up in your pocket.",
      "shots": [
        {
          "block": "hook",
          "art": "map",
          "props": [
            "coin",
            "home"
          ],
          "lines": [
            "Same salary,",
            "5 cities."
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "The expensive coastal cities claw most of it back through tax and rent. The cheaper ones let you keep far more.",
      "shots": [
        {
          "block": "rows",
          "kicker": "Kept from the same salary",
          "rows": [
            {
              "rank": "1",
              "name": "Austin / TX",
