  "scenes": [
    {
      "narration": "Let's chart America's share of the entire world's economic output, from nineteen sixty to today. The shape surprises people.",
      "shots": [
        {
          "block": "hook",
          "art": "crashChart",
          "props": [
            "globe",
            "chartDown"
          ],
          "lines": [
            "US share of",
            "world output."
