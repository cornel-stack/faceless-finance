  "scenes": [
    {
      "narration": "Markets drop in very different sizes, and each size has a nickname and a recovery story. Let's climb the ladder of fear.",
      "shots": [
        {
          "block": "hook",
          "art": "crashChart",
          "props": [
            "chartDown",
            "fire"
          ],
          "lines": [
            "-10% to -80%.",
            "What's next?"
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "A dip of ten percent is a correction. Twenty is a bear market. Fifty-plus is a true crash.",
      "shots": [
        {
          "block": "rows",
          "kicker": "Drop → name → recovery",
          "rows": [
            {
              "rank": "1",
              "name": "–10%",
