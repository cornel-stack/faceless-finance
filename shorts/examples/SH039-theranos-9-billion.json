  "scenes": [
    {
      "narration": "Theranos was once worth nine billion dollars. The only problem was that its signature machine never actually worked.",
      "shots": [
        {
          "block": "hook",
          "art": "building",
          "props": [
            "fire",
            "x"
          ],
