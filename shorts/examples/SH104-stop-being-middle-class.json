      "id": "s6"
    },
    {
      "narration": "Private banking is reserved for exactly those crossing that line.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-private",
          "kicker": "Wikipedia · private banking"
        }
      ],
      "id": "s7"
    },
    {
      "narration": "Below it, most of your wealth is probably locked up in your home and your pension.",
