      ],
      "id": "s1"
    },
    {
      "narration": "Middle class is usually defined by income, but real class is about assets, what you actually own.",
      "shots": [
        {
          "block": "truth",
          "art": "bank",
          "kicker": "the real measure",
          "line": "Assets, not income",
          "sub": "net worth is the line"
