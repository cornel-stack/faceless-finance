  "scenes": [
    {
      "narration": "The news says inflation is cooling, and everyone feels lied to, because nothing at the store got cheaper. Here's why.",
      "shots": [
        {
          "block": "hook",
          "art": "priceTag",
          "props": [
            "chartUp",
            "x"
          ],
          "lines": [
            "Inflation slowed.",
            "Prices didn't drop."
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "Inflation is the rate prices rise. When it falls from nine percent to three, prices are still rising, just slower.",
      "shots": [
        {
          "block": "thennow",
          "kicker": "Inflation vs the price level",
          "thenLabel": "Rate",
          "thenValue": "9% → 3%",
          "nowLabel": "Prices",
          "nowValue": "still UP",
          "sub": "slower, but never reversed"
        }
      ],
      "id": "s2"
    },
    {
      "narration": "Inflation is the increase in the average price of goods and services.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-inflation",
          "kicker": "Wikipedia · inflation"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "For prices to actually fall, you'd need deflation, and nobody in charge wants that.",
      "shots": [
        {
          "block": "stat",
          "art": "priceTag",
          "big": "~9%",
          "label": "US inflation peak, 2022",
          "props": [
            "fire",
            "chartUp"
          ]
        }
      ],
      "id": "s4"
    },
    {
      "narration": "The CPI tracks the price level, and that level just keeps climbing.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-cpi",
          "kicker": "Wikipedia · consumer price index"
        }
      ],
      "id": "s5"
    },
    {
      "narration": "Since twenty twenty, the cumulative rise means your dollar buys noticeably less than it did.",
      "shots": [
        {
          "block": "stat",
          "art": "crashChart",
          "big": "~20%",
          "label": "higher prices since 2020",
          "props": [
            "chartUp",
            "coin"
          ]
        }
      ],
      "id": "s6"
    },
    {
      "narration": "And when prices can't rise, the package quietly shrinks instead.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-shrink",
          "kicker": "Wikipedia · shrinkflation"
        }
      ],
      "id": "s7"
    },
    {
      "narration": "The uncomfortable truth is that your money is designed to lose value every year.",
