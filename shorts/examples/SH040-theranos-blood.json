      "id": "s1"
    },
    {
      "narration": "Real lab tests usually need blood drawn from a vein, and many separate machines to run them.",
      "shots": [
        {
          "block": "truth",
          "art": "building",
          "kicker": "the real science",
          "line": "It doesn't work that way",
          "sub": "you need a vein, and real machines"
        }
      ],
      "id": "s2"
    },
    {
      "narration": "Standard blood tests are run on samples extracted from a vein in the arm.",
