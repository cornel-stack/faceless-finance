      ],
      "id": "s1"
    },
    {
      "narration": "In most rich countries the visit is free at the point of care. In the US, it averages around a hundred seventy dollars.",
      "shots": [
        {
          "block": "stat",
          "art": "building",
          "big": "$0 vs $170",
          "label": "a routine visit: most vs US",
          "props": [
            "coin",
            "fire"
          ]
        }
      ],
      "id": "s2"
    },
    {
      "narration": "Universal systems cover the visit through taxes, not a bill.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-uhc",
          "kicker": "Wikipedia · universal health care"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "The difference isn't better doctors. It's a whole industry of middlemen sitting between you and care.",
      "shots": [
        {
          "block": "truth",
