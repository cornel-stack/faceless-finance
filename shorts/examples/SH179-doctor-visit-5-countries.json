  "scenes": [
    {
      "narration": "One routine doctor visit. Same checkup, same advice. The price swings from zero to hundreds depending on the country.",
      "shots": [
        {
          "block": "hook",
          "art": "building",
          "props": [
            "coin",
            "x"
          ],
