      "id": "s1"
    },
    {
      "narration": "Nobody with genuinely great, secret information is cold-messaging strangers to share it for free.",
      "shots": [
        {
          "block": "truth",
          "art": "building",
          "kicker": "think about it",
          "line": "Why would they tell you?",
          "sub": "real edges are never given away"
