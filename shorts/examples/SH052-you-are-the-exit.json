        {
          "block": "evidence",
          "sourceId": "wiki-pumpdump",
          "kicker": "Wikipedia · pump and dump"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "By the time the tip reaches you, insiders have already bought in low. They need your money to sell into.",
