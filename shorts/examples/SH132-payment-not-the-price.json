              "note": "as it ages",
              "color": "#5c544c",
              "bar": 0.3
            }
          ]
        }
      ],
      "id": "s4"
    },
    {
      "narration": "Total cost of ownership adds up everything a car costs you to keep.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-tco",
          "kicker": "Wikipedia · total cost of ownership"
        }
      ],
      "id": "s5"
    },
    {
      "narration": "Depreciation is the quiet killer. The biggest cost, and you never see a bill for it.",
      "shots": [
        {
          "block": "stat",
          "art": "car",
          "big": "depreciation",
          "label": "the bill you never see",
          "props": [
            "chartDown",
            "fire"
          ]
        }
      ],
      "id": "s6"
    },
    {
      "narration": "Depreciation is value quietly draining away as the car ages.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-deprec",
          "kicker": "Wikipedia · depreciation"
        }
      ],
      "id": "s7"
    },
    {
      "narration": "The dealer sells you a comfortable payment, and quietly keeps the difference as profit.",
