  "scenes": [
    {
      "narration": "Car dealers love one magic question. What monthly payment can you afford? Because the payment hides the real price.",
      "shots": [
        {
          "block": "hook",
          "art": "car",
          "props": [
            "coin",
            "x"
          ],
          "lines": [
            "The payment",
            "isn't the price."
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "Focus on a comfy monthly number, and they can stretch the loan for years to hit it, while you pay far more.",
      "shots": [
        {
          "block": "truth",
          "art": "car",
          "kicker": "the trick",
          "line": "Stretch the loan",
          "sub": "a low payment hides a high price"
        }
      ],
      "id": "s2"
    },
    {
      "narration": "Longer car loans shrink the payment but balloon the total cost.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-carfin",
          "kicker": "Wikipedia · car finance"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "The true price is the total cost of ownership. Loan, interest, insurance, fuel, repairs, and depreciation.",
      "shots": [
        {
          "block": "rows",
          "kicker": "True cost of a car",
          "rows": [
            {
