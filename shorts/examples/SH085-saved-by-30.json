  "scenes": [
    {
      "narration": "There's a classic rule of thumb for how much you should have saved by age thirty. Brace yourself.",
      "shots": [
        {
          "block": "hook",
          "art": "bank",
          "props": [
            "coin",
            "clock"
          ],
          "lines": [
            "Saved by 30?",
