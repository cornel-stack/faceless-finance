          "label": "the typical US rent today",
          "props": [
            "home",
            "coin"
          ]
        }
      ],
      "id": "s4"
    },
    {
      "narration": "And it has climbed sharply over the last decade.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-rent",
          "kicker": "Wikipedia · renting"
        }
      ],
      "id": "s5"
    },
    {
      "narration": "Landlords often want your income to be about forty times the monthly rent to even apply.",
      "shots": [
        {
          "block": "stat",
          "art": "home",
          "big": "40×",
          "label": "income vs rent, to qualify",
          "props": [
