  "scenes": [
    {
      "narration": "Here's a brutal way to measure rent, how many hours at minimum wage it takes to cover a one-bedroom. Let's map it.",
      "shots": [
        {
          "block": "hook",
          "art": "map",
          "props": [
            "home",
            "clock"
          ],
          "lines": [
            "Rent, in",
            "minimum-wage hours."
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "The federal minimum wage is seven dollars twenty-five. The wage a modest rent actually demands is closer to twenty-five.",
      "shots": [
        {
          "block": "stat",
          "art": "home",
          "big": "$7.25 vs $25",
          "label": "min wage vs rent's demand",
          "props": [
            "coin",
            "x"
          ]
        }
      ],
      "id": "s2"
    },
    {
      "narration": "A minimum wage is the legal floor on hourly pay.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-minwage",
          "kicker": "Wikipedia · minimum wage"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "In much of the country, a full-time minimum-wage check isn't enough for a one-bedroom at all.",
      "shots": [
        {
          "block": "stat",
          "art": "home",
          "big": "60–80%",
          "label": "of a full-time check, on one bedroom",
          "props": [
            "home",
            "fire"
          ]
        }
      ],
      "id": "s4"
    },
    {
      "narration": "By the affordability rule, rent should be under thirty percent of pay.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-hai",
          "kicker": "Wikipedia · housing affordability"
        }
      ],
      "id": "s5"
    },
    {
      "narration": "There is effectively no county in America where minimum wage comfortably affords a two-bedroom.",
      "shots": [
        {
          "block": "stat",
          "art": "map",
          "big": "0 counties",
          "label": "where min wage affords a 2-bed",
          "props": [
            "x",
            "home"
          ]
        }
      ],
      "id": "s6"
    },
    {
      "narration": "That gap is the difference between a minimum wage and a living wage.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-livingwage",
          "kicker": "Wikipedia · living wage"
        }
      ],
      "id": "s7"
    },
    {
      "narration": "The federal minimum hasn't risen since two thousand nine, so its real value keeps falling.",
