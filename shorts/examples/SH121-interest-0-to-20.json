          "kicker": "Wikipedia · interest rate"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "On a hundred thousand dollars saved, zero percent pays you nothing, five percent pays five thousand a year.",
      "shots": [
        {
          "block": "stat",
          "art": "bank",
          "big": "$0 vs $5,000",
