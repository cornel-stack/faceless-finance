  "scenes": [
    {
      "narration": "Forget what the bank says you can borrow. Here's the house price your salary can actually, safely support.",
      "shots": [
        {
          "block": "hook",
          "art": "home",
          "props": [
            "home",
            "coin"
          ],
          "lines": [
            "The house your",
