  "scenes": [
    {
      "narration": "Here's one of finance's cruelest ironies. The people who least need cheap money are the ones who get it.",
      "shots": [
        {
          "block": "hook",
          "art": "bank",
          "props": [
            "coin",
            "lock"
          ],
          "lines": [
            "Rich borrow",
            "cheaper."
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "A wealthy borrower is low risk to the bank, so they're offered the lowest interest rates.",
      "shots": [
        {
          "block": "truth",
          "art": "bank",
          "kicker": "why",
          "line": "Low risk, low rate",
          "sub": "the bank barely worries"
        }
      ],
      "id": "s2"
    },
    {
      "narration": "Private banking exists to give the wealthy exactly those better terms.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-private",
          "kicker": "Wikipedia · private banking"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "A struggling borrower is higher risk, so they pay the highest rates and the biggest fees.",
      "shots": [
        {
          "block": "stat",
          "art": "lock",
          "big": "35% vs 3%",
          "label": "the rate gap by wealth",
          "props": [
            "chartUp",
            "x"
          ]
        }
      ],
      "id": "s4"
    },
    {
      "narration": "At the bottom, even a small overdraft triggers a punishing fee.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-overdraft",
          "kicker": "Wikipedia · overdraft"
        }
      ],
      "id": "s5"
    },
    {
      "narration": "So the poor pay more to borrow the money they desperately need, and the rich pay less.",
      "shots": [
        {
          "block": "flash",
          "bg": "red",
          "line": "Poor pay more",
          "props": [
            "x",
            "coin"
          ]
        }
      ],
      "id": "s6"
    },
    {
      "narration": "Whole wealth-management arms exist to court the people who need it least.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-wealthmgmt",
          "kicker": "Wikipedia · wealth management"
        }
      ],
      "id": "s7"
    },
    {
      "narration": "It's a quiet tax on being poor, and a discount for being rich.",
      "shots": [
        {
          "block": "center",
          "art": "bank",
          "line": "A tax on being poor",
          "props": [
            "x",
            "coin"
          ]
        }
      ],
      "id": "s8"
    },
    {
      "narration": "The people who could most use a break get charged the steepest price for one.",
      "shots": [
        {
          "block": "flash",
          "bg": "ink",
          "line": "Charged the most",
          "props": [
            "coin",
            "chartUp"
          ]
