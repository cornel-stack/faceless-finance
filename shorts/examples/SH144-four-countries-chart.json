      "id": "s1"
    },
    {
      "narration": "For decades, the income line crawls while the price line climbs steeply away from it.",
      "shots": [
        {
          "block": "truth",
          "art": "crashChart",
          "kicker": "the gap",
          "line": "The lines split",
          "sub": "prices leave wages behind"
