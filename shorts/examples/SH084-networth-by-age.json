      "id": "s3"
    },
    {
      "narration": "Economists expect this hump shape. You borrow young, save in midlife, then spend it down.",
      "shots": [
        {
          "block": "truth",
          "art": "crashChart",
          "kicker": "the pattern",
          "line": "The wealth hump",
          "sub": "borrow, save, spend down"
        }
      ],
      "id": "s4"
    },
    {
      "narration": "That's the life-cycle hypothesis of how saving works over a lifetime.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-lifecycle",
          "kicker": "Wikipedia · life-cycle hypothesis"
        }
      ],
      "id": "s5"
    },
    {
      "narration": "The brutal lesson is time. A dollar invested at twenty-five can become fifteen by sixty-five.",
      "shots": [
        {
          "block": "stat",
          "art": "bank",
          "big": "$1 → $15",
          "label": "invested at 25, by 65",
          "props": [
            "chartUp",
            "clock"
          ]
        }
      ],
      "id": "s6"
    },
    {
      "narration": "Compound interest rewards the years far more than the dollars.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-compound",
          "kicker": "Wikipedia · compound interest"
        }
      ],
      "id": "s7"
    },
    {
      "narration": "Start early, and the whole curve bends sharply upward in your favor.",
