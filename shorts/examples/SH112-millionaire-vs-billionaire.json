      "id": "s1"
    },
    {
      "narration": "Here's the trick that makes it real. Count it in seconds instead of dollars.",
      "shots": [
        {
          "block": "truth",
          "art": "bank",
          "kicker": "picture it in time",
          "line": "Dollars as seconds",
          "sub": "the gap becomes obvious"
