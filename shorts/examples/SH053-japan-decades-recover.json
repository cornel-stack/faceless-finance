  "scenes": [
    {
      "narration": "At the end of nineteen eighty-nine, Japan's stock market hit a peak so high it then took more than thirty years to climb back.",
      "shots": [
        {
          "block": "hook",
          "art": "crashChart",
          "props": [
            "chartDown",
            "clock"
          ],
          "lines": [
            "One peak.",
            "30+ years back."
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "The bubble was almost unimaginable. At one point, the land under Tokyo was worth more than all of California.",
      "shots": [
        {
          "block": "stat",
          "art": "crashChart",
          "big": "Tokyo > CA",
          "label": "in land value, 1989",
          "props": [
            "fire",
            "chartUp"
          ]
        }
      ],
      "id": "s2"
    },
    {
      "narration": "Both real estate and stock prices were wildly, unsustainably inflated.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-bubble",
          "kicker": "Wikipedia · Japanese asset bubble"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "Then it burst. The Nikkei peaked near thirty-nine thousand, and would not see that level again for a generation.",
      "shots": [
        {
          "block": "thennow",
          "kicker": "Nikkei 225",
          "thenLabel": "1989 peak",
          "thenValue": "~38,900",
          "nowLabel": "Back above it",
