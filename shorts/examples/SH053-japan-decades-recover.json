        {
          "block": "evidence",
          "sourceId": "wiki-nikkei",
          "kicker": "Wikipedia · Nikkei 225"
        }
      ],
      "id": "s5"
    },
    {
      "narration": "In between came decades of flat growth and falling prices, nicknamed the Lost Decades.",
