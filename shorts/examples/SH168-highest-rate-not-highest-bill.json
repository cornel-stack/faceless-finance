        {
          "block": "evidence",
          "sourceId": "wiki-vat",
          "kicker": "Wikipedia · value-added tax"
        }
      ],
      "id": "s7"
    },
    {
      "narration": "So the only honest number is the total you actually hand over, everywhere combined.",
