  "scenes": [
    {
      "narration": "People panic about a high tax rate. But the headline rate and the actual bill are two very different numbers.",
      "shots": [
        {
          "block": "hook",
          "art": "bank",
          "props": [
            "coin",
            "x"
          ],
          "lines": [
            "Top rate",
            "≠ top bill."
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "The headline rate only hits your last dollar earned, not your whole income.",
      "shots": [
        {
          "block": "truth",
          "art": "bank",
          "kicker": "the key",
          "line": "It's marginal",
          "sub": "only your top dollar"
        }
      ],
      "id": "s2"
    },
    {
      "narration": "Your effective rate, the real bill, is always lower than the headline.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-rate",
          "kicker": "Wikipedia · tax rate"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "So a scary forty-five percent top rate might mean an effective rate closer to twenty-five.",
      "shots": [
        {
          "block": "stat",
          "art": "bank",
          "big": "45% vs 25%",
          "label": "headline vs effective rate",
          "props": [
            "coin",
            "check"
          ]
        }
      ],
      "id": "s4"
    },
    {
      "narration": "The tax wedge measures what's really taken across your whole income.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-wedge",
          "kicker": "Wikipedia · tax wedge"
        }
      ],
      "id": "s5"
    },
    {
      "narration": "And a low-income-tax country can quietly claw it back through a twenty percent sales tax.",
      "shots": [
        {
          "block": "stat",
          "art": "globe",
          "big": "hidden VAT",
          "label": "claws it back on spending",
          "props": [
            "coin",
            "x"
          ]
        }
      ],
      "id": "s6"
    },
    {
      "narration": "VAT is a tax you pay without ever seeing it on a payslip.",
