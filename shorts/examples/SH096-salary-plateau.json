  "scenes": [
    {
      "narration": "There's a salary level where more money quietly stops changing your day-to-day life. Researchers have tried to pin it down.",
      "shots": [
        {
          "block": "hook",
          "art": "home",
          "props": [
            "coin",
            "chartUp"
          ],
          "lines": [
            "The salary where",
            "life plateaus."
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "Below it, every extra dollar genuinely improves things, less stress, more security, better food.",
      "shots": [
        {
          "block": "stat",
          "art": "home",
          "big": "below it",
          "label": "every dollar helps a lot",
          "props": [
            "coin",
            "check"
          ]
        }
      ],
      "id": "s2"
    },
    {
      "narration": "It's really about disposable income, what's left after the essentials.",
