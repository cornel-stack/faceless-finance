      ],
      "id": "s4"
    },
    {
      "narration": "The Easterlin paradox finds rising income doesn't keep raising happiness.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-easterlin",
          "kicker": "Wikipedia · Easterlin paradox"
        }
      ],
      "id": "s5"
    },
    {
      "narration": "Studies often put that comfort plateau somewhere around six figures, depending on where you live.",
      "shots": [
        {
          "block": "stat",
          "art": "home",
          "big": "~6 figures",
          "label": "where life stops changing",
          "props": [
            "coin",
            "home"
          ]
        }
      ],
      "id": "s6"
    },
    {
      "narration": "It sits well above the typical US household income.",
