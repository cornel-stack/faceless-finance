        {
          "block": "evidence",
          "sourceId": "wiki-disposable",
          "kicker": "Wikipedia · disposable income"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "Above it, the daily experience of life barely moves. You just accumulate more.",
      "shots": [
        {
          "block": "truth",
          "art": "home",
          "kicker": "the plateau",
          "line": "Life stops changing",
          "sub": "you mostly just store it"
