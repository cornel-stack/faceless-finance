  "scenes": [
    {
      "narration": "There's a famous finding in investing. Some of the best-performing accounts belonged to people who completely forgot they had them.",
      "shots": [
        {
          "block": "hook",
          "art": "crashChart",
          "props": [
            "chartUp",
            "clock"
          ],
          "lines": [
            "They forgot.",
            "They won."
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "The reason is simple and humbling. Every time we touch our portfolio, we tend to make it worse.",
      "shots": [
        {
          "block": "truth",
          "art": "crashChart",
          "kicker": "why",
          "line": "Doing nothing wins",
          "sub": "our instincts work against us"
        }
      ],
      "id": "s2"
    },
    {
      "narration": "Behavioral economics studies exactly how our decisions deviate from rational ones.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-behavioral",
          "kicker": "Wikipedia · behavioral economics"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "We panic-sell at the bottom and greedily pile in at the top, the precise opposite of the goal.",
      "shots": [
        {
          "block": "stat",
          "art": "crashChart",
          "big": "buy high",
          "label": "sell low — the human default",
          "props": [
            "chartDown",
            "fire"
          ]
        }
      ],
      "id": "s4"
    },
    {
      "narration": "Passive investing just tracks the market and barely trades at all.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-passive",
          "kicker": "Wikipedia · passive management"
        }
      ],
      "id": "s5"
    },
    {
      "narration": "The forgotten accounts simply stayed invested and let compounding quietly do the heavy lifting.",
      "shots": [
        {
          "block": "flash",
          "bg": "ink",
          "line": "Let it compound",
          "props": [
            "coin",
            "clock"
          ]
        }
      ],
      "id": "s6"
    },
    {
      "narration": "A plain index fund holds the whole market and asks nothing of you.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-indexfund",
          "kicker": "Wikipedia · index fund"
        }
      ],
      "id": "s7"
    },
    {
      "narration": "Activity feels like progress. In investing, it's usually a tax.",
      "shots": [
        {
          "block": "center",
          "art": "crashChart",
          "line": "Activity = a tax",
          "props": [
            "x",
            "coin"
          ]
