        {
          "block": "hook",
          "art": "globe",
          "props": [
            "globe",
            "clock"
          ],
          "lines": [
            "Every one before",
            "lost the crown."
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "Portugal, Spain, the Netherlands, France, then Britain. Each took a turn running the world's money.",
