      "id": "s1"
    },
    {
      "narration": "Premiums are driven by local risk, dense traffic, theft, weather, and how litigious the state is.",
      "shots": [
        {
          "block": "truth",
          "art": "car",
          "kicker": "what drives it",
          "line": "Local risk",
          "sub": "traffic, theft, weather, lawsuits"
