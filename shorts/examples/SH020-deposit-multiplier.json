  "scenes": [
    {
      "id": "s1",
      "narration": "One deposit can become nine loans across the banking system. Here's how it snowballs.",
      "shots": [
        {
          "block": "hook",
          "art": "bank",
          "props": [
            "coin",
            "bill",
            "loop"
          ],
          "lines": [
            "1 deposit.",
            "9 loans."
          ]
        }
      ]
    },
    {
      "id": "s2",
      "narration": "You deposit a thousand. The bank keeps a little, lends the rest. That loan becomes a deposit, and gets lent again.",
      "shots": [
        {
          "block": "rows",
          "kicker": "$1,000, lent again and again",
          "rows": [
            {
              "rank": "1",
              "name": "You deposit",
              "value": "$1,000",
              "note": "into the bank",
              "color": "#1f7a3d",
              "bar": 1.0
            },
            {
              "rank": "2",
              "name": "Bank lends",
              "value": "$900",
              "note": "keeps $100",
              "color": "#17120f",
              "bar": 0.9
            },
            {
              "rank": "3",
              "name": "Lent again",
              "value": "$810",
              "note": "a new deposit",
              "color": "#17120f",
              "bar": 0.81
            },
            {
              "rank": "4",
              "name": "…and again",
              "value": "$729",
              "note": "it multiplies",
              "color": "#c0392b",
              "bar": 0.73
            }
          ]
        }
      ]
    },
    {
      "id": "s3",
      "narration": "Economists call it the money multiplier.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-multiplier",
          "kicker": "Wikipedia · money multiplier"
        }
      ]
    },
    {
      "id": "s4",
      "narration": "Which works only because banks hold a fraction in reserve.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-fractional",
          "kicker": "Wikipedia · fractional-reserve banking"
        }
      ]
    },
    {
      "id": "s5",
      "narration": "So most 'money' is really loans stacked on loans.",
      "shots": [
