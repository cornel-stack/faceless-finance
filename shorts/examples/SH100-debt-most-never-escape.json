  "scenes": [
    {
      "narration": "Some debt you pay off. But there's one level of debt that quietly traps people for life. Here it is.",
      "shots": [
        {
          "block": "hook",
          "art": "lock",
          "props": [
            "x",
            "fire"
          ],
          "lines": [
            "The debt you",
            "never escape."
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "It's not the size that traps you. It's the interest rate attached to it.",
      "shots": [
        {
          "block": "truth",
          "art": "lock",
          "kicker": "the trap",
          "line": "It's the rate",
          "sub": "not the amount"
        }
      ],
      "id": "s2"
    },
    {
      "narration": "Credit card interest compounds relentlessly against any balance you carry.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-cc",
          "kicker": "Wikipedia · credit card interest"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "Pay only the minimum on a five thousand dollar card, and you can owe nearly six thousand in interest alone.",
      "shots": [
        {
          "block": "stat",
          "art": "lock",
          "big": "$5,800",
          "label": "interest on a $5K card, minimums only",
          "props": [
