            "chartUp"
          ]
        }
      ],
      "id": "s4"
    },
    {
      "narration": "A payday loan is far worse, with rates that can reach four hundred percent a year.",
      "shots": [
        {
          "block": "stat",
          "art": "lock",
          "big": "400%",
          "label": "payday APR, vs ~7% a mortgage",
          "props": [
            "fire",
            "x"
          ]
        }
      ],
      "id": "s5"
    },
    {
      "narration": "Payday loans are defined by punishingly high interest.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-payday",
          "kicker": "Wikipedia · payday loan"
        }
      ],
      "id": "s6"
    },
    {
      "narration": "At those rates, the balance can grow faster than almost anyone can pay it down.",
      "shots": [
        {
          "block": "flash",
