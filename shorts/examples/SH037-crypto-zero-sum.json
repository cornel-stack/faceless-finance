  "scenes": [
    {
      "narration": "Here's the brutal math of most crypto trading. For you to walk away with a profit, someone else has to buy in higher.",
      "shots": [
        {
          "block": "hook",
          "art": "crashChart",
          "props": [
            "coin",
            "fire"
          ],
          "lines": [
            "Someone must",
            "buy higher."
          ]
        }
      ],
      "id": "s1"
    },
    {
      "narration": "A coin that pays no dividend and makes nothing produces no new value. It just moves money between players.",
      "shots": [
        {
          "block": "truth",
          "art": "vault",
          "kicker": "the hard part",
          "line": "It's zero-sum",
          "sub": "your gain is someone's loss"
        }
      ],
      "id": "s2"
    },
    {
      "narration": "In a zero-sum game, one player's gain is exactly another player's loss.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-zerosum",
          "kicker": "Wikipedia · zero-sum game"
        }
      ],
      "id": "s3"
    },
    {
      "narration": "So the whole thing leans on finding a greater fool willing to pay more than you did.",
      "shots": [
        {
          "block": "flash",
          "bg": "red",
          "line": "The greater fool",
          "props": [
            "x",
            "coin"
          ]
        }
      ],
      "id": "s4"
    },
    {
      "narration": "The greater fool theory is buying something purely to resell it higher.",
      "shots": [
        {
          "block": "evidence",
          "sourceId": "wiki-greaterfool",
          "kicker": "Wikipedia · greater fool theory"
        }
      ],
      "id": "s5"
    },
    {
      "narration": "Meanwhile the network burns through a country's worth of electricity every single year.",
      "shots": [
        {
          "block": "stat",
          "art": "crashChart",
          "big": "≈ a country",
          "label": "of electricity, burned yearly",
          "props": [
            "fire",
            "chartDown"
          ]
        }
      ],
      "id": "s6"
    },
    {
      "narration": "The technology is genuinely clever. The arithmetic for the average buyer is not.",
